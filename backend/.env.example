# Copy to .env to override defaults for local (non-Docker) runs.
DATABASE_URL=mysql+pymysql://sims:sims@localhost:3306/sims
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
APPROVAL_THRESHOLD=500

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email: "console" logs messages; "smtp" really sends.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@sims.io
MANAGER_FALLBACK_EMAIL=manager@sims.io
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
